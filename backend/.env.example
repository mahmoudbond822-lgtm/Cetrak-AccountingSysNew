# Cetrak backend environment example — local development values only.
# Copy to backend/.env (gitignored) and adjust for your machine.
# Never commit real secrets.

DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Database ---
POSTGRES_DB=cetrak
POSTGRES_USER=cetrak
POSTGRES_PASSWORD=cetrak
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis / Cache ---
# Django cache backend (dev.py uses db 1 for the cache).
# prod.py also reads REDIS_URL: without it, login/refresh throttle state (AUD-014)
# is per-process and the limits are effectively multiplied by the worker count,
# and /api/v1/health/ reports cache "process_local" instead of "ok".
REDIS_URL=redis://localhost:6379/1

# Run opt-in throttle cache integration tests against a real Redis with:
# CETRAK_REDIS_INTEGRATION=1
# CETRAK_REDIS_INTEGRATION=0

# --- Celery (AUD-026) ---
# Broker and result backend. db 0 is reserved for Celery.
# Locally the cache (db 1) and Celery (db 0) are separate databases. On Render all
# three of REDIS_URL / CELERY_BROKER_URL / CELERY_RESULT_BACKEND are the same
# Render Key Value connectionString, so they share one database there.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Run opt-in Celery integration tests against a real broker/worker
# (docker compose --profile worker up) with: CETRAK_CELERY_INTEGRATION=1
# CETRAK_CELERY_INTEGRATION=0

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Email delivery (AUD-015) ---
# Production (config.settings.prod) requires SMTP + explicit values and will
# fail to boot otherwise. Dev/local default to the console backend.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=Cetrak <noreply@example.com>

# Base URL of the web frontend used to build email action links.
FRONTEND_URL=http://localhost:3000