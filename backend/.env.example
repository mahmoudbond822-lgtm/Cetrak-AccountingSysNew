# Cetrak backend environment example — local development values only.
# Copy to backend/.env (gitignored) and adjust for your machine.
# Never commit real secrets.

DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Database ---
POSTGRES_DB=cetrak
POSTGRES_USER=cetrak
POSTGRES_PASSWORD=cetrak
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis / Cache ---
# Django cache backend (dev.py uses db 1 for the cache).
REDIS_URL=redis://localhost:6379/1

# --- Celery (AUD-026) ---
# Broker and result backend. db 0 is reserved for Celery.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Run opt-in Celery integration tests against a real broker/worker
# (docker compose --profile worker up) with: CETRAK_CELERY_INTEGRATION=1
# CETRAK_CELERY_INTEGRATION=0

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000